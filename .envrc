# .envrc

# Load the Nix development shell environment from the flake in the current directory
use flake

# Export environment variables needed by the rockpi-quad script
# (Based on rpi4.env.txt [cite: 91])
export SDA="SDA" # [cite: 91]
export SCL="SCL" # [cite: 91]
export OLED_RESET="D23" # [cite: 91]
export BUTTON_CHIP="0" # [cite: 91]
export BUTTON_LINE="17" # [cite: 91]
export PWMCHIP="0" # [cite: 91]
export PWM_FUN="1" # [cite: 91]
export HARDWARE_PWM="1" # [cite: 91]
export POLARITY="inversed" # [cite: 91]
export SATA_CHIP="0" # [cite: 91]
export SATA_LINE_1="25" # [cite: 91]
export SATA_LINE_2="26" # [cite: 91]

echo "Loaded rockpi-quad dev environment with Nix shell and specific vars."
